# ============================================
# POLYMARKET HOURLY BTC MARKET MAKER CONFIG
# ============================================

# === REQUIRED: Wallet Credentials ===
# Your Ethereum private key (without 0x prefix)
# To get this from Polymarket email account, see instructions below
POLY_PRIVATE_KEY=

# Your Polymarket Safe/Wallet address (from polymarket.com profile)
# This is your Polygon address that starts with 0x...
POLY_SAFE_ADDRESS=

# === SIGNATURE TYPE (IMPORTANT!) ===
# 0 = EOA (MetaMask, hardware wallet)
# 1 = Email/Magic wallet (Polymarket email login)
# 2 = Browser proxy wallet (Polymarket Safe from browser extension)
#
# For email login, use signature_type=1
POLY_SIGNATURE_TYPE=1

# === OPTIONAL: API Credentials ===
# Generate these from Polymarket settings if available
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# === Trading Parameters ===
# Minimum edge (spread) to trade (0.02 = 2%)
MIN_EDGE_THRESHOLD=0.02

# Maximum position size per trade in USD
MAX_POSITION_SIZE=100

# Maximum total exposure across all positions
MAX_TOTAL_EXPOSURE=500

# Number of price levels to quote
NUM_QUOTE_LEVELS=2

# Price spacing between levels
LEVEL_SPACING=0.01

# How often to refresh quotes (seconds)
QUOTE_REFRESH_SECONDS=5.0

# Base order size in shares
BASE_ORDER_SIZE=25

# === Risk Management ===
# Maximum drawdown before stopping (percentage)
MAX_DRAWDOWN_PCT=10

# Maximum inventory imbalance (0.6 = 60% one side)
MAX_INVENTORY_SKEW=0.6

# Minimum seconds remaining to enter a market
MIN_TIME_REMAINING=300

# Maximum trades per minute (rate limit)
MAX_TRADES_PER_MINUTE=30

# === Operational ===
# Paper trading mode (true = no real trades)
# SET TO false FOR LIVE TRADING
PAPER_TRADING=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# === Endpoints ===
POLY_CLOB_URL=https://clob.polymarket.com
POLY_GAMMA_URL=https://gamma-api.polymarket.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws


# ============================================
# HOW TO GET YOUR CREDENTIALS (Email Login)
# ============================================
#
# 1. SAFE ADDRESS:
#    - Go to https://polymarket.com
#    - Log in with your email
#    - Click on your profile icon (top right)
#    - Go to Settings or Profile
#    - Find "Wallet Address" or "Polygon Address"
#    - Copy the address (starts with 0x...)
#
# 2. PRIVATE KEY (Email/Magic accounts):
#    - This is tricky for Magic wallet accounts
#    - Option A: Check if Polymarket has "Export Private Key" in settings
#    - Option B: Use the browser console method (advanced)
#    - Option C: Create a new MetaMask wallet and transfer funds
#
# 3. FOR TESTING, START SMALL:
#    - Deposit only $10-20 initially
#    - Set MAX_POSITION_SIZE=10
#    - Set MAX_TOTAL_EXPOSURE=50
#    - Monitor closely
#
# ============================================
