# ============================================
# POLYMARKET SPORTS MARKET MAKER CONFIG
# ============================================
#
# Copy this to .env and fill in your credentials.
# Start with paper trading (PAPER_TRADING=true)!
#
# WHY SPORTS MARKETS?
# - NO FEES on sports bets (crypto has 3% taker fees)
# - Less bot competition
# - Wider spreads (2-5% typical)
# - Retail emotional betting creates edge
# - Predictable game schedules
#

# === REQUIRED: Wallet Credentials ===
# Your Ethereum private key (without 0x prefix)
POLY_PRIVATE_KEY=

# Your Polymarket Safe/Wallet address (from polymarket.com profile)
POLY_SAFE_ADDRESS=

# === SIGNATURE TYPE (IMPORTANT!) ===
# 0 = EOA (MetaMask, hardware wallet)
# 1 = Email/Magic wallet (Polymarket email login)
# 2 = Browser proxy wallet (Polymarket Safe)
#
# For email login, use signature_type=1
POLY_SIGNATURE_TYPE=1

# === OPTIONAL: API Credentials ===
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# === TRADING PARAMETERS ===
# Minimum edge (spread) to trade (0.02 = 2%)
# Higher = more conservative, fewer trades
# Lower = more aggressive, more trades
MIN_EDGE_THRESHOLD=0.02

# Maximum position size per market in USD
# Start small! Increase after testing
MAX_POSITION_SIZE=100

# Maximum total exposure across all positions
MAX_TOTAL_EXPOSURE=1000

# Number of price levels to quote
NUM_QUOTE_LEVELS=2

# Price spacing between levels (0.01 = 1%)
LEVEL_SPACING=0.01

# How often to refresh quotes (seconds)
QUOTE_REFRESH_SECONDS=5.0

# Base order size in shares
BASE_ORDER_SIZE=25

# === RISK MANAGEMENT ===
# Maximum drawdown before stopping (percentage)
MAX_DRAWDOWN_PCT=10

# Maximum inventory imbalance (0.6 = 60% one side)
MAX_INVENTORY_SKEW=0.6

# Minimum time before game start to enter (seconds)
# Don't enter markets too close to game time
MIN_TIME_REMAINING=600

# Maximum trades per minute (rate limit)
MAX_TRADES_PER_MINUTE=30

# === OPERATIONAL ===
# Paper trading mode (true = no real trades)
# START WITH THIS = true!
PAPER_TRADING=true

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# === ENDPOINTS ===
POLY_CLOB_URL=https://clob.polymarket.com
POLY_GAMMA_URL=https://gamma-api.polymarket.com


# ============================================
# QUICK START
# ============================================
#
# 1. Copy this file:
#    cp .env.sports.example .env
#
# 2. Fill in POLY_PRIVATE_KEY and POLY_SAFE_ADDRESS
#
# 3. Test your connection:
#    python scripts/test_sports_connection.py
#
# 4. Run in paper mode:
#    python -m src.sports.sports_main --paper
#
# 5. After testing, run live (CAREFUL!):
#    python -m src.sports.sports_main --live
#

# ============================================
# GETTING YOUR CREDENTIALS
# ============================================
#
# SAFE ADDRESS:
# 1. Go to https://polymarket.com
# 2. Log in with your email
# 3. Go to Profile/Settings
# 4. Copy your "Wallet Address" (starts with 0x...)
#
# PRIVATE KEY (Email/Magic accounts):
# - Check if Polymarket has "Export Private Key" option
# - Or use browser dev tools (advanced)
# - Or create new MetaMask wallet and transfer funds
#
# TESTING TIPS:
# - Start with $20-50 deposit
# - Set MAX_POSITION_SIZE=10
# - Set MAX_TOTAL_EXPOSURE=50
# - Monitor closely for first few hours
#

# ============================================
# EXPECTED RESULTS
# ============================================
#
# With $1,000 capital on sports markets:
#
# Conservative (2% min edge):
# - 5-10 trades/day
# - $10-20 daily profit
# - $300-600/month
#
# Moderate (1.5% min edge):
# - 10-20 trades/day
# - $20-40 daily profit
# - $600-1200/month
#
# Aggressive (1% min edge):
# - 20-50 trades/day
# - $40-100 daily profit
# - $1200-3000/month
#
# Results depend on market availability and volatility.
# Sports seasons (NBA, NFL) have more opportunities.
#
